APP_ENV=development
APP_NAME=NovaTech AI Knowledge Platform
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=postgresql+asyncpg://novatech:novatech_dev@postgres:5432/novatech
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=novatech_documents
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CHUNK_SIZE=900
CHUNK_OVERLAP=140
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
